# Copy to .env. Never place an OpenAI API key on the judge's computer.
SIRA_DATA_DIR=data
SIRA_RELAY_URL=
SIRA_RELAY_TOKEN=
SIRA_ORIGIN=http://127.0.0.1:8000
SIRA_SECURE_COOKIE=false
# Optional if Tesseract is not on PATH.
SIRA_TESSERACT_CMD=
SIRA_OCR_LANG=ind+eng
SIRA_MAX_PAGES=300
SIRA_VISION_ENABLED=true
# Independent AI jobs; local scanning never waits for these workers.
SIRA_OCR_WORKERS=3
